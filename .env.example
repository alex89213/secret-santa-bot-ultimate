# Public API configuration (not secret). Local Supabase: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Set in your host's secret manager or an ignored .env.local.
SUPABASE_SERVICE_ROLE_KEY=
DISCORD_BOT_TOKEN=
INSTANCE_SETUP_SECRET=
# The site's exact address. Not needed on Vercel unless you use a custom domain.
APP_URL=http://localhost:3000
# Protects the scheduled sending endpoint. Generate a separate random secret.
CRON_SECRET=
