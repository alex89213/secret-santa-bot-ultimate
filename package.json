{
  "name": "secret-santa-bot-ultimate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:privacy",
    "check:privacy": "node scripts/verify-client-privacy.mjs",
    "vercel:env": "node scripts/vercel-env.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
